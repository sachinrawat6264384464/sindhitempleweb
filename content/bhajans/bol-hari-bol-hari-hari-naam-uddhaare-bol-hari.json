      "lines": [
        "हरि जप पापी अजामिल तरिया,",
        "हरि हरि जपती गनिका तरी ॥२ ॥"
      ],
      "romanLines": [
        "Hari Jap Paapi Ajaamil Tariyaa,",
        "Hari Hari Japti Ganikaa Tari || 2 ||"
      ]
    },
    {
      "verseNumber": 3,
      "lines": [
        "कोटि जन्म अघ हरि जप नाशत,",
        "आग विषे जिमि लकड़ी जरी ॥३ ॥"
      ],
      "romanLines": [
        "Koti Janm Agh Hari Jap Naashat,",
        "Aag Vishe Jimi Lakri Jari || 3 ||"
