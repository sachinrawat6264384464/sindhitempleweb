  "verses": [
    {
      "verseNumber": 1,
      "lines": [
        "घिण्ड घड़ियाला नरसिंह भेरी,",
        "बाजत नाद नगारा, सुनले प्यारा ॥१ ॥"
      ],
      "romanLines": [
        "Ghind Ghariyaalaa Narsinh Bheri,",
        "Baajat Naad Nagaaraa, Sunle Pyaaraa || 1 ||"
