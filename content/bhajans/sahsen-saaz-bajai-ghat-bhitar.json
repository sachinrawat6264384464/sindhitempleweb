    },
    {
      "verseNumber": 2,
      "lines": [
        "तबल सारंगी सुरन्दा बाजे,",
        "चंग उपंग चौतारा, सुनले प्यारा ॥२ ॥"
      ],
      "romanLines": [
        "Tabal Saarangi Surandaa Baaje,",
        "Chang Upang Chautaaraa, Sunle Pyaaraa || 2 ||"
      ]
    },
    {
      "verseNumber": 3,
      "lines": [
        "बीन सुरीली बेहद बाजे,",
        "अनहद का धुनिकारा, सुनले प्यारा ॥३ ॥"
      ],
      "romanLines": [
        "Bin Surili Behad Baaje,",
        "Anhad Kaa Dhunikaaraa, Sunle Pyaaraa || 3 ||"
      ]
    },
    {
      "verseNumber": 4,
      "lines": [
        "कहे टेऊँ ले गुरु से युकती,",
        "साज़ सुरीले सारा, सुनले प्यारा ॥४ ॥"
      ],
      "romanLines": [
        "Kahe Teun Le Guru Se Yukti,",
        "Saaz Surile Saaraa, Sunle Pyaaraa || 4 ||"
      ]
