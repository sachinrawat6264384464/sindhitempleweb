  "verses": [
    {
      "verseNumber": 1,
      "lines": [
        "सब रंगों में सोई रंगी,",
        "रूप रंग ते न्यारा, है निर्धारा ॥१ ॥"
      ],
      "romanLines": [
        "Sab Rangon Men Soi Rangi,",
        "Rup Rang Te Nyaaraa, Hai Nirdhaaraa || 1 ||"
      ]
    },
    {
      "verseNumber": 2,
      "lines": [
        "निर्गुण से सो सर्गुण बनके,",
        "करत जगत जयकारा, धर अवतारा ॥२ ॥"
      ],
      "romanLines": [
        "Nirgun Se So Sargun Banke,",
        "Karat Jagat Jaykaaraa, Dhar Avtaaraa || 2 ||"
      ]
    },
    {
      "verseNumber": 3,
      "lines": [
        "कहता टेऊँ तीन लोक में,",
        "खेले खेल अपारा, अजब निज़ारा ॥३ ॥"
      ],
      "romanLines": [
        "Kahtaa Teun Tin Lok Men,",
        "Khele Khel Apaaraa, Ajab Nizaaraa || 3 ||"
      ]
    }
