  "verses": [
    {
      "verseNumber": 1,
      "lines": [
        "काम क्रोध लोभ अहंकारा,",
        "ममता मोह मिटाओ, शान्ती पाओ ॥१ ॥"
      ],
      "romanLines": [
        "Kaam Krodh Lobh Ahankaaraa,",
        "Mamtaa Moh Mitaao, Shaanti Paao || 1 ||"
      ]
    },
    {
      "verseNumber": 2,
      "lines": [
        "पांचों इन्द्रिय पांच विषय से,",
        "सम दम साधि हटाओ, शान्ती पाओ ॥२ ॥"
      ],
      "romanLines": [
        "Paanchon Indriy Paanch Vishay Se,",
        "Sam Dam Saadhi Hataao, Shaanti Paao || 2 ||"
      ]
    },
    {
      "verseNumber": 3,
      "lines": [
        "मन को मार दृढ़ कर आसन,",
        "इत उत नाहिं डुलाओ, शान्ती पाओ ॥३ ॥"
      ],
      "romanLines": [
        "Man Ko Maar Drirh Kar Aasan,",
        "It Ut Naahin Dulaao, Shaanti Paao || 3 ||"
      ]
    },
    {
      "verseNumber": 4,
      "lines": [
        "कहता टेऊँ गगन मण्डल में,",
        "अपनी श्रुति समाओ, शान्ती पाओ ॥४ ॥"
      ],
      "romanLines": [
        "Kahtaa Teun Gagan Mandal Men,",
        "Apni Shruti Samaao, Shaanti Paao || 4 ||"
      ]
    }
