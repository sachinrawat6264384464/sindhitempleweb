  "romanTitle": "Aatm Chintan Nishdin Karle",
  "firstLine": "Aatm Chintan Nishdin Karle, Guru Ke Charan Dhyaao, Shaanti Paao (Tek).",
  "lyrics": [
    [
      "ातम चिनतन निशदिन करले,",
      "गुरु के चरण धयाो, शांति पाो (टेक)."
    ],
    [
      "काम करोध लोभ हनकारा,",
      "ममता मोह मिताो, शांति पाो. ||.1. ||."
    ],
    [
      "पानचोन िनदरिय पानच विशय से,",
      "सम दम साधि हताो, शांति पाो ||.2 ||"
    ],
    [
      "मन को मार दरिरह कर ासन,",
      "ित ुत नाहिन दुलाो, शांति पाो. ||.3 ||"
    ],
    [
      "कहता तेऊँ गगन मनदल मेन,",
      "पनि शरुति समाो, शांति पाो || 4 ||."
    ]
  ],
  "romanLyrics": [
    [
      "Aatm Chintan Nishdin Karle,",
      "Guru Ke Charan Dhyaao, Shaanti Paao (Tek)."
    ],
    [
      "Kaam Krodh Lobh Ahankaaraa,",
      "Mamtaa Moh Mitaao, Shaanti Paao. ||.1. ||."
    ],
    [
      "Paanchon Indriy Paanch Vishay Se,",
      "Sam Dam Saadhi Hataao, Shaanti Paao ||.2 ||"
    ],
    [
      "Man Ko Maar Drirh Kar Aasan,",
      "It Ut Naahin Dulaao, Shaanti Paao. ||.3 ||"
    ],
    [
      "Kahtaa Teun Gagan Mandal Men,",
      "Apni Shruti Samaao, Shaanti Paao || 4 ||."
    ]
  ],
