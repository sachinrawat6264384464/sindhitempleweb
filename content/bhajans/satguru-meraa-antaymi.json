  "firstLine": "Sat‌Guru Meraa Antaymi, Puran Par Upkaari, Nit Avtaari (Tek).",
  "lyrics": [
    [
      "सतगुरु मेरा नतयमि,",
      "पुरन पर ुपकारि, नित वतारि (टेक)."
    ],
    [
      "पाप ताप हर पानच कलेशा,",
      "मन कि ममता मारि, दुरमति तारि. || 1. ||."
    ],
    [
      "नुभव जयोति जगाे ुर मेन,",
      "विदया रैन निवारि, कर ुजियारि || 2 ||."
    ],
    [
      "योग भयास कि युकति देके,",
      "खोलि सुशुमन नारि, भयि सुध सारि ||.3 ||"
    ],
    [
      "कहे तेऊँ गुरु ज्ञान बताया,",
      "पाया पद निरधारि, ति सुखकारि ||.4 ||"
    ]
  ],
  "romanLyrics": [
    [
      "Sat‌Guru Meraa Antaymi,",
      "Puran Par Upkaari, Nit Avtaari (Tek)."
    ],
    [
      "Paap Taap Har Paanch Kleshaa,",
      "Man Ki Mamtaa Maari, Durmati Taari. || 1. ||."
    ],
    [
      "Anubhav Jyoti Jagaae Ur Men,",
      "Avidyaa Rain Nivaari, Kar Ujiyaari || 2 ||."
    ],
    [
      "Yog Abhyaas Ki Yukti Deke,",
      "Kholi Sushumn Naari, Bhayi Sudh Saari ||.3 ||"
    ],
    [
      "Kahe Teun Guru Jnyaan Bataayaa,",
      "Paayaa Pad Nirdhaari, Ati Sukhkaari ||.4 ||"
    ]
