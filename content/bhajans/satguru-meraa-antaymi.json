  ],
  "romanTek": [
    "Sat‌Guru Meraa Antaymi,",
    "Puran Par Upkaari, Nit Avtaari (Tek)."
  ],
  "verses": [
    {
      "verseNumber": 1,
      "lines": [
        "पाप ताप हर पांच क्लेशा,",
        "मन की ममता मारी, दुर्मति टारी ॥१ ॥"
      ],
      "romanLines": [
        "Paap Taap Har Paanch Kleshaa,",
        "Man Ki Mamtaa Maari, Durmati Taari || 1 ||"
      ]
    },
    {
      "verseNumber": 2,
      "lines": [
        "अनुभव ज्योति जगाए उर में,",
        "अविद्या रैन निवारी, कर उजियारी ॥२ ॥"
      ],
      "romanLines": [
        "Anubhav Jyoti Jagaae Ur Men,",
        "Avidyaa Rain Nivaari, Kar Ujiyaari || 2 ||"
      ]
    },
    {
      "verseNumber": 3,
      "lines": [
        "योग अभ्यास की युक्ती देके,",
        "खोली सुषुम्न नाड़ी , भयी सुध सारी ॥३ ॥"
      ],
      "romanLines": [
        "Yog Abhyaas Ki Yukti Deke,",
        "Kholi Sushumn Naari, Bhayi Sudh Saari || 3 ||"
      ]
    },
    {
      "verseNumber": 4,
      "lines": [
        "कहे टेऊँ गुरु ज्ञान बताया,",
        "पाया पद निर्धारी, अति सुखकारी ॥४ ॥"
      ],
      "romanLines": [
        "Kahe Teun Guru Gyaan Bataayaa,",
        "Paayaa Pad Nirdhaari, Ati Sukhkaari || 4 ||"
      ]
    }
  ],
