  "heading": "।। राग कोह्लारी भजन ।। ७ ।। ४ं८७।।",
  "tek": [
    "सद्गुरु अपनी कृपा करके,",
    "दीना पुर कर प्याला, वहदत वाला ॥ टेक ॥"
  ],
  "romanTek": [
    "Sadguru Apni Kripaa Karke,",
    "Dinaa Pur Kar Pyaalaa, Vahdat Vaalaa (Tek)."
  ],
  "verses": [
    {
      "verseNumber": 1,
      "lines": [
        "हरदम खुद मस्ती के अन्दर,",
        "मस्त भया मतिवाला, रहूं निराला ॥१ ॥"
      ],
      "romanLines": [
        "Hardam Khud Masti Ke Andar,",
        "Mast Bhayaa Mativaalaa, Rahun Niraalaa || 1 ||"
      ]
    },
    {
      "verseNumber": 2,
      "lines": [
        "धर्मराय का लेखा चूका,",
        "हट गया काल कराला, जम जैँजाला ॥२ ॥"
      ],
      "romanLines": [
        "Dharmaraay Kaa Lekhaa Chukaa,",
        "Hat Gayaa Kaal Karaalaa, Jam Jainjaalaa || 2 ||"
      ]
    },
    {
      "verseNumber": 3,
      "lines": [
        "अमर देश में वासा कीया,",
        "देखा दीन दयाला, भया निहाला ॥३ ॥"
      ],
      "romanLines": [
        "Amar Desh Men Vaasaa Kiyaa,",
        "Dekhaa Din Dayaalaa, Bhayaa Nihaalaa || 3 ||"
      ]
    },
    {
      "verseNumber": 4,
      "lines": [
        "कहता टेऊँ गुरु प्रसादे,",
        "खुलिया अनुभव ताला, रहा सुखाला ॥४ ॥"
      ],
      "romanLines": [
        "Kahtaa Teun Guru Prasaade,",
        "Khuliyaa Anubhav Taalaa, Rahaa Sukhaalaa || 4 ||"
      ]
    }
  ],
