  "romanTitle": "Sadguru Apni Kripaa Karke",
  "firstLine": "Sadguru Apni Kripaa Karke, Dinaa Pur Kar Pyaalaa, Vahdat Vaalaa (Tek).",
  "lyrics": [
    [
      "सद्गुरु पनि कृपा करके,",
      "दिना पुर कर पयाला, वहदत वाला (टेक)."
    ],
    [
      "हरदम खुद मसति के नदर,",
      "मसत भया मतिवाला, रहुन निराला || 1 ||."
    ],
    [
      "धरमराय का लेखा चुका,",
      "हत गया काल कराला, जम जैनजाला ||.2 ||"
    ],
    [
      "मर देश मेन वासा किया,",
      "देखा दीन दयाला, भया निहाला ||.3 ||"
    ],
    [
      "कहता तेऊँ गुरु परसादे,",
      "खुलिया नुभव ताला, रहा सुखाला || 4 ||."
    ]
  ],
  "romanLyrics": [
    [
      "Sadguru Apni Kripaa Karke,",
      "Dinaa Pur Kar Pyaalaa, Vahdat Vaalaa (Tek)."
    ],
    [
      "Hardam Khud Masti Ke Andar,",
      "Mast Bhayaa Mativaalaa, Rahun Niraalaa || 1 ||."
    ],
    [
      "Dharmaraay Kaa Lekhaa Chukaa,",
      "Hat Gayaa Kaal Karaalaa, Jam Jainjaalaa ||.2 ||"
    ],
    [
      "Amar Desh Men Vaasaa Kiyaa,",
      "Dekhaa Din Dayaalaa, Bhayaa Nihaalaa ||.3 ||"
    ],
    [
      "Kahtaa Teun Guru Prasaade,",
      "Khuliyaa Anubhav Taalaa, Rahaa Sukhaalaa || 4 ||."
    ]
  ],
